{
  "run": {
    "enabled_modes": ["unified_digest"],
    "timezone": "Asia/Shanghai",
    "time_window_hours": 168,
    "max_items": 50,
    "dry_run": false,
    "state_path": "data/aurora_state.json",
    "cache_dir": "data/cache",
    "output_dir": "data/runs"
  },
  "delivery": {
    "email": {
      "enabled": true,
      "smtp_host": "smtp.gmail.com",
      "smtp_port": 465,
      "smtp_username_env": "SMTP_USERNAME",
      "password_env": "EMAIL_PASSWORD",
      "sender_name": "Aurora",
      "recipients_env": "AURORA_EMAIL_RECIPIENTS"
    },
    "github_pages": {
      "enabled": true,
      "publish_dir": "web/src/content/posts"
    },
    "filesystem": {
      "enabled": true,
      "reports_dir": "reports",
      "site_dir": "site"
    }
  },
  "ai": {
    "max_tokens": 650,
    "max_requests_per_run": 12,
    "max_network_attempts_per_run": 18,
    "max_tokens_per_run": 240000,
    "fail_open_on_budget_exceeded": true,
    "analysis_concurrency": 2,
    "transient_retry_attempts": 2,
    "retry_backoff_sec": 1.0
  },
  "release_gate": {
    "enabled": true,
    "ledger_path": "data/cache/release_gate.json",
    "required_clean_runs": 7,
    "retain_runs": 14
  },
  "modes": {
    "tech_news": {
      "llm_analysis_top_n": 0,
      "filters": {
        "require_include_keyword": true,
        "include_keywords": [
          "ai",
          "ml",
          "llm",
          "agent",
          "agents",
          "open source ai",
          "model",
          "models",
          "inference",
          "reasoning",
          "benchmark",
          "dataset",
          "evaluation",
          "rag",
          "mcp",
          "computer vision",
          "multimodal",
          "local llm"
        ]
      },
      "sources": {
        "hackernews": {
          "enabled": true,
          "fetch_top_stories": 100,
          "min_score": 30,
          "top_comments_limit": 3
        },
        "rss": [
          {
            "name": "Simon Willison",
            "url": "https://simonwillison.net/atom/everything/",
            "enabled": true,
            "category": "ai-tools"
          },
          {
            "name": "OpenAI News",
            "url": "https://openai.com/news/rss.xml",
            "enabled": true,
            "category": "ai-labs"
          },
          {
            "name": "Google AI Blog",
            "url": "https://blog.google/innovation-and-ai/technology/ai/rss/",
            "enabled": true,
            "category": "ai-labs"
          },
          {
            "name": "Google DeepMind Blog",
            "url": "https://deepmind.google/blog/rss.xml",
            "enabled": true,
            "category": "ai-research"
          },
          {
            "name": "AWS Machine Learning Blog",
            "url": "https://aws.amazon.com/blogs/machine-learning/feed/",
            "enabled": true,
            "category": "ai-infrastructure"
          },
          {
            "name": "Hugging Face Blog",
            "url": "https://huggingface.co/blog/feed.xml",
            "enabled": true,
            "category": "ai-tools"
          },
          {
            "name": "NVIDIA AI Blog",
            "url": "https://developer.nvidia.com/blog/category/generative-ai/feed/",
            "enabled": true,
            "category": "ai-infrastructure"
          }
        ],
        "reddit": {
          "enabled": true,
          "subreddits": ["MachineLearning", "LocalLLaMA"],
          "listing": "top",
          "time_filter": "day",
          "limit": 15,
          "min_score": 150
        },
        "github_releases": {
          "enabled": true,
          "repositories": [
            "openai/openai-python",
            "huggingface/transformers",
            "vllm-project/vllm",
            "modelcontextprotocol/python-sdk"
          ],
          "per_repo_limit": 3
        }
      }
    },
    "scholar": {
      "fields": ["ml", "agents"],
      "max_candidates": 200,
      "final_item_count": 10,
      "llm_analysis_top_n": 0,
      "score_threshold": 5.5,
      "sources": {
        "arxiv": {
          "enabled": true,
          "max_results": 200
        },
        "openreview": {
          "enabled": true
        },
        "semantic_scholar": {
          "enabled": true,
          "api_key_env": "SEMANTIC_SCHOLAR_API_KEY",
          "cache_ttl_hours": 168,
          "max_requests_per_run": 20,
          "rate_limit_interval_sec": 2.0,
          "max_retries": 4,
          "retry_delay_sec": 5.0
        }
      }
    },
    "repo_learning": {
      "interests": ["agents", "mcp", "workflow-automation"],
      "sources": {
        "github_search": {
          "enabled": true,
          "token_env": "GH_SEARCH_TOKEN",
          "domains": ["ai-agents", "mcp-ecosystem", "workflow-automation"],
          "custom_keywords": [],
          "languages": [],
          "min_stars": 100,
          "recent_years": 5,
          "active_within_days": 365,
          "per_page": 30
        }
      },
      "ranking": {
        "final_item_count": 6,
        "enrich_top_n": 12,
        "llm_analysis_top_n": 0,
        "history_lookback_days": 14
      }
    },
    "unified_digest": {
      "enabled": true,
      "include_modes": ["tech_news", "scholar", "repo_learning"],
      "max_items_per_type": 8,
      "max_total_items": 11,
      "section_limits": {
        "news": 5,
        "repo": 3,
        "paper": 3
      },
      "minimum_section_items": {
        "news": 5,
        "repo": 3,
        "paper": 3
      },
      "cross_mode_clusters": true,
      "section_order": ["news", "repo", "paper"]
    }
  }
}
