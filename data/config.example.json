{
  "run": {
    "enabled_modes": ["unified_digest"],
    "timezone": "Asia/Shanghai",
    "time_window_hours": 24,
    "max_items": 50,
    "dry_run": false,
    "state_path": "data/aurora_state.json",
    "cache_dir": "data/cache",
    "output_dir": "data/runs"
  },
  "modes": {
    "tech_news": {
      "sources": {
        "hackernews": {
          "enabled": true,
          "fetch_top_stories": 60,
          "min_score": 100,
          "top_comments_limit": 5
        },
        "rss": []
      }
    },
    "scholar": {
      "fields": ["ml", "agents"],
      "max_candidates": 200,
      "final_item_count": 10,
      "score_threshold": 7.0,
      "sources": {
        "semantic_scholar": {
          "enabled": true,
          "api_key_env": "SEMANTIC_SCHOLAR_API_KEY",
          "cache_ttl_hours": 168,
          "max_requests_per_run": 40
        }
      }
    },
    "repo_learning": {
      "interests": ["agents", "mcp", "workflow-automation"],
      "sources": {
        "github_search": {
          "enabled": true,
          "token_env": "GH_SEARCH_TOKEN",
          "domains": ["ai-agents", "mcp-ecosystem", "workflow-automation"],
          "custom_keywords": [],
          "languages": [],
          "min_stars": 500,
          "recent_years": 2,
          "active_within_days": 180,
          "per_page": 20
        }
      },
      "ranking": {
        "final_item_count": 6,
        "enrich_top_n": 12,
        "history_lookback_days": 14
      }
    },
    "unified_digest": {
      "enabled": true,
      "include_modes": ["tech_news", "scholar", "repo_learning"],
      "max_items_per_type": 8,
      "max_total_items": 20,
      "cross_mode_clusters": true,
      "section_order": ["paper", "repo", "news"]
    }
  }
}
