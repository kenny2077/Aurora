---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Datetime from "@/components/Datetime.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const latestDigest = sortedPosts[0];
const previousDigests = sortedPosts.slice(1);
const homePath = getRelativeLocaleUrl(locale, "");

const monthGroups = previousDigests.reduce(
  (groups, post) => {
    const date = new Date(post.data.pubDatetime);
    const label = new Intl.DateTimeFormat("en", {
      month: "long",
      year: "numeric",
      timeZone: post.data.timezone ?? config.site.timezone,
    }).format(date);
    groups[label] ??= [];
    groups[label].push(post);
    return groups;
  },
  {} as Record<string, typeof previousDigests>
);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-muted-foreground text-sm font-medium tracking-wide uppercase">
            Aurora Unified Digest
          </p>
          <h1 class="my-3 max-w-2xl text-3xl font-bold sm:text-4xl">
            High-signal curation for developers.
          </h1>
          <p class="max-w-2xl text-base">
            A compact daily scan of tech news, GitHub repositories, and research
            papers, generated by Aurora System.
          </p>
        </div>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="mt-1 inline-flex size-10 items-center justify-center"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>
    </section>

    {
      latestDigest && (
        <section id="today" class="border-border border-b py-10">
          <div class="mb-4 flex items-center justify-between gap-4">
            <h2 class="text-2xl font-semibold tracking-wide">
              Today's Digest
            </h2>
            <span class="border-border text-muted-foreground rounded border px-2 py-1 text-sm">
              {latestDigest.data.digest_date ??
                new Intl.DateTimeFormat("en-CA", {
                  timeZone:
                    latestDigest.data.timezone ?? config.site.timezone,
                }).format(new Date(latestDigest.data.pubDatetime))}
            </span>
          </div>
          <article class="border-border bg-muted/25 rounded-lg border p-5">
            <a
              href={getPostUrl(latestDigest.id, latestDigest.filePath, locale)}
              class="text-accent decoration-dashed underline-offset-4 hover:underline"
            >
              <h3 class="text-xl font-semibold">{latestDigest.data.title}</h3>
            </a>
            <div class="my-2">
              <Datetime {...latestDigest.data} />
            </div>
            <p>{latestDigest.data.description}</p>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {latestDigest.data.featured_repo && (
                <p class="border-border rounded border p-3 text-sm">
                  <span class="text-muted-foreground block">Featured repo</span>
                  <b>{latestDigest.data.featured_repo}</b>
                </p>
              )}
              {latestDigest.data.featured_paper && (
                <p class="border-border rounded border p-3 text-sm">
                  <span class="text-muted-foreground block">
                    Featured paper
                  </span>
                  <b>{latestDigest.data.featured_paper}</b>
                </p>
              )}
            </div>
            <LinkButton
              href={getPostUrl(latestDigest.id, latestDigest.filePath, locale)}
              class="mt-5 inline-flex items-center gap-1"
            >
              Open digest
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </article>
        </section>
      )
    }

    <section id="previous-digests" class="py-10">
      <h2 class="text-2xl font-semibold tracking-wide">Previous Digests</h2>
      {
        Object.entries(monthGroups).length > 0 ? (
          Object.entries(monthGroups).map(([month, group]) => (
            <section class="mt-6">
              <h3 class="text-muted-foreground text-sm font-semibold tracking-wide uppercase">
                {month}
              </h3>
              <ul class="mt-3">
                {group.map(post => (
                  <li class="border-border flex flex-col gap-1 border-t py-4 sm:flex-row sm:items-center sm:justify-between">
                    <a
                      href={getPostUrl(post.id, post.filePath, locale)}
                      class="text-accent font-medium decoration-dashed underline-offset-4 hover:underline"
                    >
                      {post.data.title}
                    </a>
                    <Datetime {...post.data} />
                  </li>
                ))}
              </ul>
            </section>
          ))
        ) : (
          <p class="text-muted-foreground mt-4">
            Previous digests will appear after additional Aurora runs.
          </p>
        )
      }
      <div class="my-8 text-center">
        <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
          All digests
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
