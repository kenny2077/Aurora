---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const latestDigest = sortedPosts[0];
const previousDigests = sortedPosts.slice(1);
const homePath = getRelativeLocaleUrl(locale, "");

const digestDate = latestDigest
  ? latestDigest.data.digest_date ??
    new Intl.DateTimeFormat("en-CA", {
      timeZone: latestDigest.data.timezone ?? config.site.timezone,
    }).format(new Date(latestDigest.data.pubDatetime))
  : "";

const archiveGroups = previousDigests.reduce(
  (groups, post) => {
    const label = new Intl.DateTimeFormat("en", {
      month: "long",
      year: "numeric",
      timeZone: post.data.timezone ?? config.site.timezone,
    }).format(new Date(post.data.pubDatetime));
    groups[label] ??= [];
    groups[label].push(post);
    return groups;
  },
  {} as Record<string, typeof previousDigests>
);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section class="border-border border-b py-12 sm:py-16">
      <p class="text-muted-foreground text-sm tracking-wide uppercase">
        Aurora Unified Digest
      </p>
      <h1 class="mt-4 max-w-2xl text-3xl leading-tight font-semibold sm:text-4xl">
        A quiet daily brief for builders.
      </h1>
      <p class="text-muted-foreground mt-5 max-w-2xl text-base leading-7">
        Tech news, useful repositories, and research papers distilled into one
        compact reading queue.
      </p>
    </section>

    {
      latestDigest && (
        <section class="border-border border-b py-10">
          <div class="mb-5 flex items-end justify-between gap-4">
            <div>
              <p class="text-muted-foreground text-sm tracking-wide uppercase">
                Latest
              </p>
              <h2 class="mt-1 text-2xl font-semibold">Today's Digest</h2>
            </div>
            <time class="text-muted-foreground text-sm" datetime={digestDate}>
              {digestDate}
            </time>
          </div>

          <a
            href={getPostUrl(latestDigest.id, latestDigest.filePath, locale)}
            class="group border-border hover:border-accent/40 block rounded-lg border p-5 transition-colors"
          >
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h3 class="text-accent text-xl font-semibold">
                  {latestDigest.data.title}
                </h3>
                <p class="text-muted-foreground mt-2 max-w-xl leading-7">
                  {latestDigest.data.description}
                </p>
                <div class="mt-3">
                  <Datetime {...latestDigest.data} />
                </div>
              </div>
              <span class="inline-flex items-center gap-1 whitespace-nowrap font-medium group-hover:text-accent">
                Read
                <IconArrowRight class="inline-block rtl:-rotate-180" />
              </span>
            </div>
          </a>
        </section>
      )
    }

    <section class="py-10">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="text-muted-foreground text-sm tracking-wide uppercase">
            Archive
          </p>
          <h2 class="mt-1 text-2xl font-semibold">Previous Digests</h2>
        </div>
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="text-muted-foreground hover:text-accent text-sm"
        >
          All digests
        </a>
      </div>

      {
        Object.entries(archiveGroups).length > 0 ? (
          Object.entries(archiveGroups).map(([month, group]) => (
            <section class="mt-7">
              <h3 class="text-muted-foreground text-sm tracking-wide uppercase">
                {month}
              </h3>
              <ul class="mt-3 divide-y divide-border">
                {group.map(post => (
                  <li class="py-4">
                    <a
                      href={getPostUrl(post.id, post.filePath, locale)}
                      class="group flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
                    >
                      <span class="font-medium group-hover:text-accent">
                        {post.data.title}
                      </span>
                      <Datetime {...post.data} class="sm:justify-end" />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        ) : (
          <p class="text-muted-foreground">
            Previous digests will appear after additional Aurora runs.
          </p>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
